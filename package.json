{
	"name": "pattern-css",
	"version": "1.0.0",
	"description": "My amazing block",
	"author": "Kevin Batdorf",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build",
		"format": "biome format --write .",
		"lint": "biome check .",
		"lint:fix": "biome check --fix .",
		"packages-update": "ncu -u --reject shiki,tailwindcss && ncu -u --target minor '/^tailwind/'",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start",
		"test:e2e": "node scripts/run-e2e.mjs",
		"test:e2e:ui": "npx playwright test --ui",
		"eject": "node scripts/eject.mjs",
		"rename": "node scripts/rename.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@playwright/test": "^1.62.1",
		"@types/wordpress__block-editor": "^15.0.6",
		"@types/wordpress__edit-post": "^8.4.2",
		"@types/wordpress__editor": "^14.12.0",
		"@types/wordpress__plugins": "^6.0.0",
		"@wordpress/block-editor": "^16.1.0",
		"@wordpress/e2e-test-utils-playwright": "^1.52.0",
		"@wordpress/scripts": "^34.0.0",
		"@wordpress/url": "^4.52.0",
		"@wp-playground/cli": "^3.1.48",
		"autoprefixer": "^10.5.4",
		"fast-glob": "^3.3.3",
		"glob": "^13.0.6",
		"postcss-import": "^16.1.1",
		"postcss-safe-important": "^2.0.1",
		"replace-in-file": "^9.0.0",
		"shiki": "^0.14.7",
		"tailwindcss": "^3.4.19",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@wordpress/block-editor": "^16.1.0",
		"@wordpress/blocks": "^15.25.0",
		"@wordpress/edit-post": "^8.52.0",
		"@wordpress/editor": "^14.52.0",
		"@wordpress/element": "^8.4.0",
		"@wordpress/i18n": "^6.25.0",
		"@wordpress/plugins": "^7.52.0",
		"browserlist": "^1.0.2",
		"lightningcss": "1.33.0",
		"lightningcss-wasm": "1.33.0",
		"react-simple-code-editor": "^0.14.1",
		"shiki": "^4.4.1",
		"swr": "^2.5.0",
		"zustand": "^5.0.14"
	}
